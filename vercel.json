{
  "version": 2,
  "builds": [
    { "src": "api/**/*.py", "use": "@vercel/python" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "out" } }
  ],
  "routes": [
    { "src": "/api/qimen", "dest": "/api/qimen.py" },
    { "src": "/(.*)", "dest": "index.html" }
  ]
}
